# Store the real file at /etc/flowie-backup/credentials (0600), outside Git.
RESTIC_REPOSITORY=s3:https://independent-storage.example/flowie-disaster-recovery
RESTIC_PASSWORD_FILE=/etc/flowie-backup/repository-password
AWS_ACCESS_KEY_ID=configure-outside-git
AWS_SECRET_ACCESS_KEY=configure-outside-git
AWS_DEFAULT_REGION=us-east-1
