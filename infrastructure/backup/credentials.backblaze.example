# Copy outside Git to /etc/flowie-backup/credentials with mode 0600.
# Replace both endpoint/region placeholders with values from the actual B2 bucket.
RESTIC_REPOSITORY=s3:https://s3.REGION.backblazeb2.com/BUCKET/flowie
RESTIC_PASSWORD_FILE=/etc/flowie-backup/repository-password
AWS_ACCESS_KEY_ID=configure-bucket-scoped-key-id-outside-git
AWS_SECRET_ACCESS_KEY=configure-application-key-outside-git
AWS_DEFAULT_REGION=REGION
