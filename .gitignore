# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
.test-build/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.flowie-operation.lock

# UI regression artifacts
apps/web/.e2e-fixture.json
apps/web/test-results/
apps/web/playwright-report/

/photos

# Local MCP client configuration: each machine points at its own Flowie
# endpoint and names the environment variable holding its token, so the file
# is per-developer and must never be committed.
# VI: Cấu hình MCP client cục bộ: mỗi máy trỏ tới endpoint Flowie của riêng nó
# VI: và nêu tên biến môi trường chứa token, nên file này thuộc từng lập trình
# VI: viên và không bao giờ được commit.
.mcp.json

# Rust build output for the Flowie Desktop workspace.
# VI: Kết quả build Rust của workspace Flowie Desktop.
apps/desktop/target/
# Capability schemas regenerated by tauri-build on every compile.
# VI: Schema capability do tauri-build sinh lại mỗi lần biên dịch.
apps/desktop/src-tauri/gen/schemas/

# editors
.idea/
