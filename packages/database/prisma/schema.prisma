generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum IdentityProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  OIDC
  SAML
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum IssueStatusCategory {
  TRIAGE
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectType {
  GENERAL
  PRODUCT
  MARKETING
  OPERATIONS
  EVENT
  CLIENT
  RESEARCH
  CUSTOM
}

enum ProjectCustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
  URL
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  username      String?      @unique
  title         String?
  avatarUrl     String?      @map("avatar_url")
  passwordHash  String?      @map("password_hash")
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  lastLoginAt   DateTime?    @map("last_login_at")

  identities    UserIdentity[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  memberships   WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceMember[] @relation("WorkspaceInvitationSender")
  teamMemberships TeamMember[]
  organizations Organization[] @relation("OrganizationOwner")
  createdIssues Issue[] @relation("IssueCreator")
  assignedIssues Issue[] @relation("IssueAssignee")
  issueSubscriptions IssueSubscription[]
  projectSubscriptions ProjectSubscription[]
  projectUpdates ProjectUpdate[] @relation("ProjectUpdateAuthor")
  createdDocuments Document[] @relation("DocumentCreator")
  updatedDocuments Document[] @relation("DocumentUpdater")
  comments Comment[]
  activities Activity[] @relation("ActivityActor")
  notifications Notification[]
  uploadedAttachments Attachment[]
  savedViews SavedView[] @relation("SavedViewCreator")
  ledProjects Project[] @relation("ProjectLead")
  ownedInitiatives Initiative[] @relation("InitiativeOwner")

  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model UserIdentity {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  provider          IdentityProvider
  providerAccountId String           @map("provider_account_id")
  email             String?
  tenantId          String?          @map("tenant_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User        @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

model Workspace {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  name           String
  slug           String            @unique
  description    String?
  timezone       String            @default("UTC")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  teams        Team[]
  projects     Project[]
  issueStatuses IssueStatus[]
  issues       Issue[]
  cycles       Cycle[]
  documents    Document[]
  labels       Label[]
  attachments  Attachment[]
  activities   Activity[]
  discordWebhook DiscordWebhook?
  projectCustomFields ProjectCustomField[]
  projectTemplates ProjectTemplate[]
  projectMilestones ProjectMilestone[]
  projectUpdates ProjectUpdate[]
  savedViews SavedView[]
  initiatives Initiative[]

  @@index([organizationId])
  @@map("workspaces")
}

model DiscordWebhook {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  webhookUrl  String   @map("webhook_url")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("discord_webhooks")
}

model AuditLog {
  id         String   @id @default(cuid())
  workspaceId String? @map("workspace_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  identifier  String
  description String?
  icon        String?  @default("👥")
  color       String?  @default("#6366f1")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  projects  Project[]
  issues    Issue[]
  issueSequence Int @default(0) @map("issue_sequence")
  cycles    Cycle[]
  documents Document[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("teams")
}

model Project {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  teamId      String?  @map("team_id")
  name        String
  identifier  String
  description String?
  type        ProjectType @default(GENERAL)
  status      String   @default("planned")
  priority    String   @default("none")
  health      String   @default("no-update")
  leadId      String?  @map("lead_id")
  startDate   DateTime? @map("start_date")
  targetDate  DateTime? @map("target_date")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lead User? @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues Issue[]
  activities Activity[]
  milestones ProjectMilestone[]
  customFieldValues ProjectCustomFieldValue[]
  initiativeLinks InitiativeProject[]
  subscriptions ProjectSubscription[]
  updates ProjectUpdate[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId, teamId])
  @@map("projects")
}

model ProjectCustomField {
  id          String                 @id @default(cuid())
  workspaceId String                 @map("workspace_id")
  name        String
  type        ProjectCustomFieldType
  description String?
  options     Json?
  required    Boolean                @default(false)
  position    Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    ProjectCustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("project_custom_fields")
}

model ProjectCustomFieldValue {
  projectId String @map("project_id")
  fieldId   String @map("field_id")
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field   ProjectCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([projectId, fieldId])
  @@index([fieldId])
  @@map("project_custom_field_values")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  projectId   String    @map("project_id")
  title       String
  description String?
  targetDate  DateTime? @map("target_date")
  completedAt DateTime? @map("completed_at")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

model ProjectSubscription {
  projectId String @map("project_id")
  userId    String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_subscriptions")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  authorId    String   @map("author_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User      @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("project_updates")
}

model ProjectTemplate {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  description String?
  type        ProjectType @default(GENERAL)
  config      Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("project_templates")
}

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  createdById String   @map("created_by")
  name        String
  entityType  String   @map("entity_type")
  filters     Json     @default("{}")
  isShared    Boolean  @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SavedViewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType])
  @@map("saved_views")
}

model Initiative {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  description String?
  status      String   @default("planned")
  priority    String   @default("none")
  health      String   @default("no-update")
  icon        String?  @default("🎯")
  ownerId     String?  @map("owner_id")
  targetDate  DateTime? @map("target_date")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User?                @relation("InitiativeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectLinks InitiativeProject[]

  @@index([workspaceId, archivedAt])
  @@index([ownerId])
  @@map("initiatives")
}

model InitiativeProject {
  initiativeId String @map("initiative_id")
  projectId    String @map("project_id")
  createdAt    DateTime @default(now()) @map("created_at")

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([initiativeId, projectId])
  @@index([projectId])
  @@map("initiative_projects")
}

model TeamMember {
  teamId String         @map("team_id")
  userId String         @map("user_id")
  role   TeamMemberRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model IssueStatus {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  teamId      String?             @map("team_id")
  name        String
  category    IssueStatusCategory
  color       String
  icon        String?
  position    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues Issue[]

  @@index([workspaceId, teamId])
  @@map("issue_statuses")
}

model Issue {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  teamId      String        @map("team_id")
  statusId    String        @map("status_id")
  projectId   String?       @map("project_id")
  identifier  String
  number      Int
  title       String
  description String?
  priority    IssuePriority @default(NONE)
  estimate    Int?
  dueDate     DateTime?     @map("due_date")
  creatorId   String        @map("creator_id")
  assigneeId  String?       @map("assignee_id")
  completedAt DateTime?     @map("completed_at")
  canceledAt  DateTime?     @map("canceled_at")
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    IssueStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator   User        @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee  User?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  cycleLinks IssueCycle[]
  comments Comment[]
  activities Activity[]
  labelLinks IssueLabel[]
  subscribers IssueSubscription[]

  @@unique([workspaceId, identifier])
  @@unique([teamId, number])
  @@index([workspaceId, teamId, statusId])
  @@index([projectId])
  @@index([assigneeId])
  @@map("issues")
}

model IssueSubscription {
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId, createdAt])
  @@map("issue_subscriptions")
}

model Cycle {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  teamId      String      @map("team_id")
  name        String
  description String?
  status      CycleStatus @default(UPCOMING)
  startDate   DateTime?   @map("start_date")
  endDate     DateTime?   @map("end_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issueLinks IssueCycle[]

  @@index([workspaceId, teamId, status])
  @@map("cycles")
}

model IssueCycle {
  issueId String @map("issue_id")
  cycleId String @map("cycle_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  cycle Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@id([issueId, cycleId])
  @@index([cycleId])
  @@map("issue_cycles")
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  teamId      String?  @map("team_id")
  title       String
  content     String   @default("")
  createdById String   @map("created_by")
  updatedById String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy User      @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User      @relation("DocumentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, teamId])
  @@map("documents")
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId, createdAt])
  @@map("comments")
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  issueId     String?  @map("issue_id")
  projectId   String?  @map("project_id")
  actorId     String?  @map("actor_id")
  type        String
  data        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     User?     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([issueId, createdAt])
  @@index([projectId, createdAt])
  @@map("activities")
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issueLinks IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model IssueLabel {
  issueId String @map("issue_id")
  labelId String @map("label_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
  @@map("issue_labels")
}

model Notification {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  data       Json?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  uploadedById String  @map("uploaded_by")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  objectKey   String   @unique @map("object_key")
  filename    String
  mimeType    String   @map("mime_type")
  size        Int
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, entityType, entityId])
  @@map("attachments")
}

model WorkspaceMember {
  id          String                @id @default(cuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  status      WorkspaceMemberStatus @default(INVITED)
  role        WorkspaceMemberRole   @default(MEMBER)
  joinedAt    DateTime?             @map("joined_at")
  invitedById String?               @map("invited_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}
