generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum IdentityProvider {
  LOCAL
  GOOGLE
  MICROSOFT
  OIDC
  SAML
}

enum WorkspaceMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamMemberRole {
  LEAD
  MEMBER
}

enum TeamJoinPolicy {
  OPEN
  INVITE_ONLY
}

enum IssueStatusCategory {
  TRIAGE
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
  CANCELED
}

enum IssuePriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueResolution {
  DUPLICATE
  WONT_FIX
}

enum IssueRelationType {
  RELATED
  BLOCKS
}

enum ProjectType {
  GENERAL
  PRODUCT
  MARKETING
  OPERATIONS
  EVENT
  CLIENT
  RESEARCH
  CUSTOM
}

enum ProjectCustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  BOOLEAN
  URL
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  username        String?    @unique
  title           String?
  timezone        String     @default("UTC")
  avatarUrl       String?    @map("avatar_url")
  passwordHash    String?    @map("password_hash")
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  lastLoginAt     DateTime?  @map("last_login_at")

  identities               UserIdentity[]
  sessions                 Session[]
  personalApiKeys          PersonalApiKey[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  memberships              WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceMember[]        @relation("WorkspaceInvitationSender")
  teamMemberships          TeamMember[]
  organizations            Organization[]           @relation("OrganizationOwner")
  createdIssues            Issue[]                  @relation("IssueCreator")
  assignedIssues           Issue[]                  @relation("IssueAssignee")
  createdIssueRelations    IssueRelation[]
  issueSubscriptions       IssueSubscription[]
  issueReactions           IssueReaction[]
  commentReactions         CommentReaction[]
  issueFavorites           IssueFavorite[]
  issueReminders           IssueReminder[]
  projectSubscriptions     ProjectSubscription[]
  projectFavorites         ProjectFavorite[]
  projectMemberships       ProjectMember[]
  projectUpdates           ProjectUpdate[]          @relation("ProjectUpdateAuthor")
  initiativeUpdates        InitiativeUpdate[]       @relation("InitiativeUpdateAuthor")
  initiativeResources      InitiativeResource[]     @relation("InitiativeResourceCreator")
  projectResources         ProjectResource[]        @relation("ProjectResourceCreator")
  createdDocuments         Document[]               @relation("DocumentCreator")
  updatedDocuments         Document[]               @relation("DocumentUpdater")
  comments                 Comment[]
  activities               Activity[]               @relation("ActivityActor")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  uploadedAttachments      Attachment[]
  savedViews               SavedView[]              @relation("SavedViewCreator")
  ledProjects              Project[]                @relation("ProjectLead")
  ownedInitiatives         Initiative[]             @relation("InitiativeOwner")
  createdIssueTemplates    IssueTemplate[]          @relation("IssueTemplateCreator")
  createdReleases          Release[]                @relation("ReleaseCreator")
  createdCustomerRequests  CustomerRequest[]        @relation("CustomerRequestCreator")
  createdSlaPolicies       SlaPolicy[]              @relation("SlaPolicyCreator")
  createdAsks              Ask[]                    @relation("AskCreator")
  createdWorkspaceEmojis   WorkspaceEmoji[]         @relation("WorkspaceEmojiCreator")

  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PersonalApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, createdAt])
  @@index([expiresAt])
  @@map("personal_api_keys")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model UserIdentity {
  id                String           @id @default(cuid())
  userId            String           @map("user_id")
  provider          IdentityProvider
  providerAccountId String           @map("provider_account_id")
  email             String?
  tenantId          String?          @map("tenant_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner      User        @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaces Workspace[]

  @@index([ownerId])
  @@map("organizations")
}

model Workspace {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  name                   String
  slug                   String   @unique
  icon                   String?
  description            String?
  timezone               String   @default("UTC")
  projectDisplayDefaults Json?    @map("project_display_defaults")
  issueDisplayDefaults   Json?    @map("issue_display_defaults")
  issueInsightDefaults   Json?    @map("issue_insight_defaults")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members                 WorkspaceMember[]
  teams                   Team[]
  projects                Project[]
  issueStatuses           IssueStatus[]
  issues                  Issue[]
  issueRelations          IssueRelation[]
  cycles                  Cycle[]
  documents               Document[]
  documentFolders         DocumentFolder[]
  labels                  Label[]
  labelGroups             LabelGroup[]
  attachments             Attachment[]
  activities              Activity[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  discordWebhook          DiscordWebhook?
  projectCustomFields     ProjectCustomField[]
  projectTemplates        ProjectTemplate[]
  projectMilestones       ProjectMilestone[]
  projectLabels           ProjectLabel[]
  projectStatuses         ProjectStatus[]
  projectUpdates          ProjectUpdate[]
  savedViews              SavedView[]
  initiatives             Initiative[]
  initiativeUpdates       InitiativeUpdate[]
  initiativeResources     InitiativeResource[]
  projectResources        ProjectResource[]
  issueTemplates          IssueTemplate[]
  releases                Release[]
  customerRequests        CustomerRequest[]
  slaPolicies             SlaPolicy[]
  asks                    Ask[]
  emojis                  WorkspaceEmoji[]

  @@index([organizationId])
  @@map("workspaces")
}

model DiscordWebhook {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  webhookUrl  String   @map("webhook_url")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("discord_webhooks")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  actorId     String?  @map("actor_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Team {
  id                     String         @id @default(cuid())
  workspaceId            String         @map("workspace_id")
  name                   String
  identifier             String
  description            String?
  icon                   String?        @default("👥")
  color                  String?        @default("#6366f1")
  joinPolicy             TeamJoinPolicy @default(OPEN) @map("join_policy")
  triageEnabled          Boolean        @default(true) @map("triage_enabled")
  cycleCadenceWeeks      Int?           @map("cycle_cadence_weeks")
  autoCloseDays          Int?           @map("auto_close_days")
  autoArchiveDays        Int?           @map("auto_archive_days")
  parentTeamId           String?        @map("parent_team_id")
  defaultIssueTemplateId String?        @map("default_issue_template_id")
  archivedAt             DateTime?      @map("archived_at")
  deletedAt              DateTime?      @map("deleted_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members              TeamMember[]
  projects             Project[]
  issues               Issue[]
  issueSequence        Int              @default(0) @map("issue_sequence")
  cycles               Cycle[]
  documents            Document[]
  documentFolders      DocumentFolder[]
  slaPolicies          SlaPolicy[]
  asks                 Ask[]
  parentTeam           Team?            @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams           Team[]           @relation("TeamHierarchy")
  defaultIssueTemplate IssueTemplate?   @relation(fields: [defaultIssueTemplateId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([parentTeamId])
  @@index([defaultIssueTemplateId])
  @@map("teams")
}

model Project {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  teamId      String?     @map("team_id")
  name        String
  identifier  String
  description String?
  type        ProjectType @default(GENERAL)
  status      String      @default("planned")
  priority    String      @default("none")
  health      String      @default("no-update")
  leadId      String?     @map("lead_id")
  startDate   DateTime?   @map("start_date")
  targetDate  DateTime?   @map("target_date")
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team              Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  lead              User?                     @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues            Issue[]
  activities        Activity[]
  milestones        ProjectMilestone[]
  customFieldValues ProjectCustomFieldValue[]
  initiativeLinks   InitiativeProject[]
  releaseLinks      ReleaseProject[]
  customerRequests  CustomerRequest[]
  asks              Ask[]
  labelLinks        ProjectLabelLink[]
  subscriptions     ProjectSubscription[]
  favorites         ProjectFavorite[]
  updates           ProjectUpdate[]
  resources         ProjectResource[]
  members           ProjectMember[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId, teamId])
  @@map("projects")
}

model ProjectMember {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectCustomField {
  id          String                 @id @default(cuid())
  workspaceId String                 @map("workspace_id")
  name        String
  type        ProjectCustomFieldType
  description String?
  options     Json?
  required    Boolean                @default(false)
  position    Int                    @default(0)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    ProjectCustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("project_custom_fields")
}

model ProjectCustomFieldValue {
  projectId String   @map("project_id")
  fieldId   String   @map("field_id")
  value     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  field   ProjectCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([projectId, fieldId])
  @@index([fieldId])
  @@map("project_custom_field_values")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  projectId   String    @map("project_id")
  title       String
  description String?
  targetDate  DateTime? @map("target_date")
  completedAt DateTime? @map("completed_at")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_milestones")
}

model ProjectSubscription {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_subscriptions")
}

model ProjectFavorite {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_favorites")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  authorId    String   @map("author_id")
  body        String
  kind        String   @default("update")
  health      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User      @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("project_updates")
}

model ProjectResource {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  createdById String   @map("created_by")
  label       String
  url         String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ProjectResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("project_resources")
}

model ProjectTemplate {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  description String?
  type        ProjectType @default(GENERAL)
  config      Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("project_templates")
}

model ProjectStatus {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  category    String
  color       String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, category, position])
  @@map("project_statuses")
}

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  createdById String   @map("created_by")
  name        String
  description String?
  entityType  String   @map("entity_type")
  filters     Json     @default("{}")
  isShared    Boolean  @default(false) @map("is_shared")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SavedViewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType])
  @@map("saved_views")
}

model Initiative {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  description String?
  status      String    @default("planned")
  priority    String    @default("none")
  health      String    @default("no-update")
  icon        String?   @default("🎯")
  ownerId     String?   @map("owner_id")
  targetDate  DateTime? @map("target_date")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User?                @relation("InitiativeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectLinks InitiativeProject[]
  labelLinks   InitiativeLabelLink[]
  updates      InitiativeUpdate[]
  resources    InitiativeResource[]

  @@index([workspaceId, archivedAt])
  @@index([ownerId])
  @@map("initiatives")
}

model InitiativeProject {
  initiativeId String   @map("initiative_id")
  projectId    String   @map("project_id")
  createdAt    DateTime @default(now()) @map("created_at")

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([initiativeId, projectId])
  @@index([projectId])
  @@map("initiative_projects")
}

model InitiativeUpdate {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  initiativeId String   @map("initiative_id")
  authorId     String   @map("author_id")
  body         String
  health       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  author     User       @relation("InitiativeUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([initiativeId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("initiative_updates")
}

model InitiativeResource {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  initiativeId String   @map("initiative_id")
  createdById  String   @map("created_by")
  label        String
  url          String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("InitiativeResourceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([initiativeId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("initiative_resources")
}

model Release {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  version     String
  description String?
  status      String    @default("planned")
  targetDate  DateTime? @map("target_date")
  releasedAt  DateTime? @map("released_at")
  createdById String    @map("created_by")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User             @relation("ReleaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  projectLinks ReleaseProject[]
  issueLinks   IssueRelease[]

  @@unique([workspaceId, version])
  @@index([workspaceId, archivedAt])
  @@map("releases")
}

model ReleaseProject {
  releaseId String   @map("release_id")
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([releaseId, projectId])
  @@index([projectId])
  @@map("release_projects")
}

model IssueRelease {
  releaseId String   @map("release_id")
  issueId   String   @map("issue_id")
  createdAt DateTime @default(now()) @map("created_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issue   Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([releaseId, issueId])
  @@index([issueId])
  @@map("issue_releases")
}

model CustomerRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  title       String
  description String?
  customer    String
  source      String    @default("manual")
  status      String    @default("open")
  priority    String    @default("none")
  projectId   String?   @map("project_id")
  issueId     String?   @map("issue_id")
  createdById String    @map("created_by")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: SetNull)
