{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowie Desktop",
  "version": "../../../package.json",
  "identifier": "io.flowie.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Flowie Desktop",
        "width": 960,
        "height": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "BSR",
    "shortDescription": "Flowie Desktop companion",
    "longDescription": "Runs Flowie tasks on this machine with a local coding agent.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Vietnamese"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
