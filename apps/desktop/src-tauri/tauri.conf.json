{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowie Desktop",
  "version": "0.0.0",
  "identifier": "io.flowie.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Flowie Desktop",
        "width": 960,
        "height": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
