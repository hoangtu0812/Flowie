{
   "name": "flowie",
    "version": "0.18.0",
   "private": true,
   "packageManager": "pnpm@9.15.9",
   "scripts": {
      "dev": "pnpm --filter @flowie/web dev",
      "dev:web": "pnpm --filter @flowie/web dev",
      "build": "pnpm --filter @flowie/contracts build && pnpm --filter @flowie/database generate && pnpm --filter @flowie/web build",
      "lint": "pnpm --filter @flowie/web lint",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "db:generate": "pnpm --filter @flowie/database generate",
      "db:migrate": "pnpm --filter @flowie/database migrate",
      "infra:up": "docker compose up -d --no-build --pull never postgres minio",
      "infra:down": "docker compose down",
      "docker:up": "docker compose --profile app up -d --no-build --pull never",
      "docker:down": "docker compose --profile app down",
      "docker:logs": "docker compose --profile app logs -f",
      "docker:build": "docker compose --profile app build",
      "docker:rebuild": "docker compose --profile app up -d --build"
   },
   "devDependencies": {
      "prettier": "^3.5.3",
      "typescript": "^5.8.3"
   }
}
