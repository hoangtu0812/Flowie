# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Also used by the API to build the links inside Discord notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000
# Container network MTU. Lower it to the uplink's path MTU when the network
# path is smaller than 1500 (check with: ping -M do -s 1472 1.1.1.1).
DOCKER_NETWORK_MTU=1400
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false

# Optional Discord bot broadcaster. Create a Discord application/bot, add it
# to your server, then set both values only on the server (.env.production).
# Never expose the token through NEXT_PUBLIC_* variables or commit it.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=

# First platform administrator. Leave unset in production until a secure password is supplied.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_NAME=Flowie Administrator
ADMIN_RESET_PASSWORD=false

# PostgreSQL
POSTGRES_DB=circle
POSTGRES_USER=circle
POSTGRES_PASSWORD=circle
POSTGRES_PORT=5433
DATABASE_URL=postgresql://circle:circle@localhost:5433/circle?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
TEAM_POLICY_SCAN_INTERVAL_MS=3600000

# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=circle-local
