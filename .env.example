# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Also used by the API to build the links inside Discord notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000
# Container network MTU. Lower it to the uplink's path MTU when the network
# path is smaller than 1500 (check with: ping -M do -s 1472 1.1.1.1).
DOCKER_NETWORK_MTU=1400
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_ACCOUNT_LIMIT=20
AUTH_LOGIN_IP_LIMIT=300
# Independent comma-separated Fernet keys, newest first; configure outside Git.
AUTH_MFA_ENCRYPTION_KEYS=

# Private password recovery email. STARTTLS is required unless SMTP_USE_SSL=true.
# Recovery is unavailable until SMTP_HOST and SMTP_FROM are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Microsoft Entra ID (Azure AD) sign-in. Register the callback as a Web
# redirect URI and grant delegated User.Read so Flowie can sync the signed-in
# user's display name and profile photo.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:4000/api/v1/auth/microsoft/callback

# The only platform administrator. The comparison is case-insensitive and is
# evaluated by the API on every authenticated request.
ADMIN_EMAIL=admin@example.com

# Optional Discord bot broadcaster. Create a Discord application/bot, add it
# to your server, then set both values only on the server (.env.production).
# Never expose the token through NEXT_PUBLIC_* variables or commit it.
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL_ID=
# The server that will contain the automatically created private #flowie-register
# channel. If a normal Discord bot channel is configured, Flowie can discover
# its guild from that channel instead.
DISCORD_BOT_GUILD_ID=
# Optional: use an existing private channel rather than creating flowie-register.
DISCORD_REGISTRATION_CHANNEL_ID=
# Discord role that can view registration OTPs (the bot and server admins can
# always access them). Do not use @everyone.
DISCORD_REGISTRATION_CHANNEL_ROLE_ID=
REGISTRATION_OTP_TTL_SECONDS=600

# A URL-safe, base64-encoded 32-byte Fernet key used to encrypt workspace AI
# provider keys at rest. Generate it once with Python's Fernet.generate_key().
# Keep the same value for the lifetime of every encrypted provider key.
AGENT_SECRETS_ENCRYPTION_KEY=

# Reviews / source-control integrations. Generate the Fernet key independently
# from other application encryption keys and keep all values out of Git.
SCM_SECRETS_ENCRYPTION_KEY=
SCM_GITHUB_APP_ID=
SCM_GITHUB_APP_PRIVATE_KEY=
SCM_GITHUB_WEBHOOK_SECRET=

# Model Context Protocol endpoint for external coding agents. The transport is
# mounted at /mcp/ only while MCP_ENABLED=true, and a reverse proxy in front of
# the API must route /mcp/ to it. Mutation tools and the agent run dispatcher
# stay unavailable until MCP_WRITES_ENABLED=true.
MCP_ENABLED=false
MCP_WRITES_ENABLED=false
# DNS-rebinding protection compares the request Host against this list, so it
# must name every public hostname the endpoint is reached through. Entries are
# comma-separated and may end in :* to accept any port.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Tool calls per minute per workspace; raise it for agents that read widely.
MCP_RATE_LIMIT=60
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_RESULT_BYTES=262144
MCP_MAX_IDEMPOTENCY_KEYS=10000

# PostgreSQL
POSTGRES_DB=circle
POSTGRES_USER=circle
POSTGRES_PASSWORD=circle
POSTGRES_PORT=5433
DATABASE_URL=postgresql://circle:circle@localhost:5433/circle?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
TEAM_POLICY_SCAN_INTERVAL_MS=3600000

# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=circle-local
