# ─────────────────────────────────────────────────────────────
# Flowie — environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# App
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=flowie
POSTGRES_PASSWORD=flowie_dev_password
POSTGRES_DB=flowie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DSN dùng bởi backend (trong docker compose host = "db")
DATABASE_URL=postgres://flowie:flowie_dev_password@localhost:5432/flowie?sslmode=disable

# Session / JWT
# Sinh chuỗi ngẫu nhiên >= 32 bytes: `openssl rand -base64 48`
SESSION_SECRET=CHANGE_ME_to_a_long_random_secret_value_min_32_bytes
SESSION_TTL_HOURS=24

# ── Azure AD (OpenID Connect) ────────────────────────────────
# App registration trong Azure Portal → Entra ID → App registrations
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
# Redirect URI phải khớp với cấu hình trên Azure App Registration
AZURE_AD_REDIRECT_URL=http://localhost:8080/api/v1/auth/azure/callback

# ── SharePoint / Microsoft Graph (giai đoạn file storage) ────
# Có thể tái dùng cùng App Registration (cần Graph API permission:
# Sites.ReadWrite.All / Files.ReadWrite.All - application permission).
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
# Site và folder gốc để đồng bộ file. Ví dụ:
#   SHAREPOINT_SITE_URL=contoso.sharepoint.com:/sites/Projects
SHAREPOINT_SITE_URL=your-tenant.sharepoint.com:/sites/YourSite
# Đường dẫn folder gốc bên trong document library (Drive) để chứa dữ liệu Flowie
SHAREPOINT_ROOT_FOLDER=/Flowie
